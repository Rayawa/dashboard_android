<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive layers are 1.5 times the visible icon size. Use proportional padding so
     the logo stays inside the central safe circle at every installer/launcher size. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="18%">
    <bitmap
        android:src="@drawable/harmony_launcher_foreground"
        android:gravity="fill" />
</inset>
